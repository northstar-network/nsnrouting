# Cloudflare API Token — required permissions:
#   Zone > DNS > Edit
#   Zone > Zone > Read
#   Restricted to the easydeploy.tech zone
CF_DNS_API_TOKEN=your_cloudflare_api_token_here

# Traefik dashboard basic auth
# Generate with: docker run --rm httpd:alpine htpasswd -nB admin
# Replace each $ with $$ in this .env file
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$05$$...hash_here...
